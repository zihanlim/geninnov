# Andromeda -- backend Python env vars
# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
# Reference: CLAUDE.md > Environment variables

# ─── Supabase (REQUIRED for daily_refresh.py) ────────────────────────────────
# Service-role key has write access; anon key only has RLS-bounded read access.
# Find both in: Supabase dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Supabase (REQUIRED for Next.js frontend, public-prefixed) ──────────────
# These NEXT_PUBLIC_* values are inlined into the browser bundle, so they must
# only be the anon key, NEVER the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Brave Search News API (OPTIONAL) ────────────────────────────────────────
# Without this, daily_refresh.py's news fetch falls back to a Python-side mock.
# Get a key at: https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=

# ─── Reddit PRAW (OPTIONAL) ──────────────────────────────────────────────────
# Without these, daily_refresh.py's Reddit fetch falls back to a Python-side mock.
# Create a script app at: https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=Andromeda/1.0
