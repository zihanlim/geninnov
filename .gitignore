# Dependencies
node_modules/

# Build output — .next-* covers the alternate-distDir builds the audit/verify
# scripts produce (.next-audit, .next-verify*, .next-dev-clean, and any future one)
frontend/.next/
frontend/.next-*/
.next/

# Environment variables
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Python bytecode
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Logs
*.log
npm-debug.log*

# TypeScript build info
frontend/tsconfig.tsbuildinfo

.vercel

# One-off debug/verification scripts (not part of test suite)
tests/backend/check_*.py
tests/backend/debug_*.py
tests/backend/fix_*.py
tests/backend/populate_*.py
tests/backend/run_q1_*.py
tests/backend/seed_*.py
tests/backend/show_*.py
tests/backend/smoke_*.py
tests/backend/verify_*.py
tests/backend/*.json

# Playwright verification artifacts
.playwright-mcp/
/*.png
backend/data/factors_daily.csv

# Local virtualenvs. No pattern existed here, so any venv made at the repo root
# was a commit away from being tracked.
.venv/
.venv-*/
venv/

# Pulled by `vercel env pull`. Values are redacted placeholders EXCEPT
# VERCEL_OIDC_TOKEN, which is a real ~1.2KB JWT. Never commit this.
.env.vercel

# External design mockups pulled in for reference (Stitch/Auralis SaaS zip etc.).
# Not Andromeda code — kept out of the repo so `git add -A` never bloats it.
stitch_remix*

# Playwright run artifacts — regenerated every run, never reviewed.
frontend/test-results/
frontend/playwright-report/
